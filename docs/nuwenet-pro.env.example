# Plantilla de preparación. NO reemplazar .env: conservar claves y configuración existente.
# No está cargada por la aplicación. Completar y fusionar solo al activar el servicio.

# Candidato LAN observado: 192.168.0.2 (Wi-Fi). Confirmar/reservar IP antes de activarlo.
# HOST=0.0.0.0
# PORT=3000
# NUWENET_PORTAL_IP=192.168.0.2
# NUWENET_PUBLIC_URL=http://192.168.0.2:3000
# NUWENET_CAPTIVE_PORT=3080
# NUWENET_ADMIN_CONTACT=
# NUWENET_SUSPENSION_MESSAGE=Comunícate con administración para regularizar tu servicio.
# El acceso público con tokens requiere URL HTTPS y certificado confiable.
# Un proxy HTTPS debe reenviar también /api y estar configurado en TRUST_PROXY.

# Mantener deshabilitado hasta completar la configuración y revisar la cola.
NOTIFY_CHANNEL=whatsapp
WHATSAPP_SEND_ENABLED=false
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_TEMPLATE=
WHATSAPP_LANGUAGE=
# Confirmación de entrega: callback público HTTPS /api/whatsapp/webhook
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# Banco: pendiente de elección en Bolivia.
# Los datos se guardan por edificio desde Mensualidades > Datos bancarios / QR.
# No se configuran cuentas ni QR en este archivo.
