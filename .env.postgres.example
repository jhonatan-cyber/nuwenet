DB_DRIVER=postgres
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=nuwenet
PGUSER=postgres
PGPASSWORD=replace_with_your_password
PGSSLMODE=disable
PORT=3000
HOST=127.0.0.1
# On a hosted database use its hostname and the SSL mode it requires.
# Example: PGSSLMODE=verify-full
# DATABASE_URL may be used instead of the PG* connection variables.
# Required before saving router credentials; keep the same key across API instances.
# ROUTER_ENCRYPTION_KEY=your_32_byte_base64_key
# ROUTER_BROWSER_CHANNEL=chrome
