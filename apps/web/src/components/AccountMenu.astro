---
---
<div class="relative" data-account-menu>
  <button id="account-trigger" class="flex items-center gap-2.5 rounded-md border border-transparent bg-background px-2 py-1.5 text-left hover:bg-muted" type="button" aria-label="Menú de usuario" aria-haspopup="menu" aria-expanded="false" aria-controls="account-dropdown">
    <span class="grid size-8 place-items-center rounded-full bg-muted text-[13px]" id="account-avatar" aria-hidden="true">A</span>
    <span class="text-xs max-[700px]:hidden"><strong id="account-name">Administrador</strong><small class="block text-[11px] text-muted-foreground">Mi cuenta</small></span>
    <svg class="size-4 text-muted-foreground max-[700px]:hidden" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="m6 9 6 6 6-6" /></svg>
  </button>
  <div id="account-dropdown" class="absolute top-[calc(100%+8px)] right-0 z-50 w-56 rounded-lg border bg-card p-1 shadow-xl" role="menu" aria-labelledby="account-trigger" hidden>
    <div class="px-3 py-2 text-[10px] tracking-widest text-muted-foreground" role="presentation">MI CUENTA</div>
    <button type="button" role="menuitem" data-account="profile" class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-left text-sm hover:bg-muted [&_svg]:size-4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 21v-2a7 7 0 0 1 14 0v2"/></svg>Perfil</button>
    <button type="button" role="menuitem" data-account="settings" class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-left text-sm hover:bg-muted [&_svg]:size-4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 7h16M4 17h16"/><circle cx="9" cy="7" r="3" fill="white"/><circle cx="15" cy="17" r="3" fill="white"/></svg>Configuraciones</button>
    <div class="my-1 border-t" role="separator"></div>
    <button type="button" role="menuitem" data-action="logout" class="flex w-full items-center gap-2 rounded-md px-3 py-2 text-left text-sm text-destructive hover:bg-muted [&_svg]:size-4"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M10 4H4v16h6M10 12h11m-4-4 4 4-4 4"/></svg>Cerrar sesión</button>
  </div>
</div>
