---
import '../styles/ui.css';
import '../styles/application.css';
import ThemeInit from '../components/ThemeInit.astro';
import { card, tableHead, tableCell, input, buttonOutline } from '../lib/shadcn.js';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <ThemeInit />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" />
  <meta name="referrer" content="no-referrer" />
  <meta name="robots" content="noindex,nofollow" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Portal de autoservicio para residentes – consulta tu plan, facturas y recibos." />
  <title>Mi Portal · NuweNet</title>
</head>
<body class="portal-page">
  <header class="flex items-center gap-4 border-b px-6 py-5 max-[700px]:px-4">
    <div class="text-2xl font-semibold tracking-tight">Nuwe<span>Net</span></div>
    <span id="building-name"></span>
  </header>

  <div id="portal-loading" class="flex min-h-[60vh] flex-col items-center justify-center gap-4 p-6 text-center">
    <div class="size-4 animate-spin rounded-full border-2 border-current border-r-transparent"></div>
    <p>Cargando tu información…</p>
  </div>

  <div id="portal-error" class="flex min-h-[60vh] flex-col items-center justify-center gap-4 p-6 text-center text-destructive" style="display:none">
    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
    <p id="error-msg">No se pudo cargar tu portal.</p>
  </div>

  <div id="portal-content" class="mx-auto max-w-[1100px] px-6 py-8 max-[700px]:px-4" style="display:none">
    <div id="portal-switch-wrap" class="mb-6 flex-wrap items-center gap-3" style="display:none">
      <label for="portal-dept-switch" class="text-sm font-medium">Departamento</label>
      <select id="portal-dept-switch" class={input}></select>
      <button type="button" id="portal-forget" class={buttonOutline}>Olvidar este enlace</button>
    </div>
    <!-- Info cards -->
    <div class="grid gap-4 [grid-template-columns:repeat(auto-fit,minmax(180px,1fr))] max-[700px]:grid-cols-2">
      <div class:list={[card, 'p-6 max-[700px]:p-4']}>
        <div class="text-sm text-muted-foreground">Departamento</div>
        <div class="mt-1 text-xl font-semibold tracking-tight" id="p-apt">—</div>
      </div>
      <div class:list={[card, 'p-6 max-[700px]:p-4']}>
        <div class="text-sm text-muted-foreground">Titular</div>
        <div class="mt-1 text-xl font-semibold tracking-tight" id="p-name">—</div>
      </div>
      <div class:list={[card, 'p-6 max-[700px]:p-4']}>
        <div class="text-sm text-muted-foreground">Estado de servicio</div>
        <div class="mt-1 text-xl font-semibold tracking-tight" id="p-status">—</div>
      </div>
      <div class:list={[card, 'p-6 max-[700px]:p-4']}>
        <div class="text-sm text-muted-foreground">Plan contratado</div>
        <div class="mt-1 text-xl font-semibold tracking-tight" id="p-plan">—</div>
      </div>
      <div class:list={[card, 'p-6 max-[700px]:p-4']}>
        <div class="text-sm text-muted-foreground">Velocidad</div>
        <div class="mt-1 text-xl font-semibold tracking-tight" id="p-speed">—</div>
      </div>
    </div>

    <!-- Invoices table -->
    <div class="mt-8 mb-4 text-lg font-semibold">Mis Facturas</div>
    <div class="overflow-x-auto rounded-lg border">
      <table class="w-full text-left text-sm">
        <thead>
          <tr>
            <th class={tableHead}>#</th>
            <th class={tableHead}>Periodo</th>
            <th class={tableHead}>Vencimiento</th>
            <th class={tableHead}>Monto</th>
            <th class={tableHead}>Estado</th>
          </tr>
        </thead>
        <tbody id="invoices-body">
          <tr><td colspan="5" class={tableCell}>Cargando…</td></tr>
        </tbody>
      </table>
    </div>

    <div id="usage-history"></div>
    <div class="mt-8 mb-4 text-lg font-semibold">Consumo en vivo</div>
    <p id="p-traffic" aria-live="polite">Consultando…</p><small class="block text-sm text-muted-foreground">Contadores del router desde su último reinicio o reinicio de cola; no representan un total mensual.</small>
    <div class="mt-8 mb-4 text-lg font-semibold">Mis pagos y recibos</div>
    <label class="flex items-center gap-2 text-sm font-medium">Papel <select id="ticket-width" class={input}><option value="80">80 mm</option><option value="58">58 mm</option></select></label>
    <div id="payments-list"></div>
  </div>

  <footer class="p-8 text-center text-xs text-muted-foreground">
    Portal del residente · NuweNet
  </footer>

  <script>
    import '../scripts/portal.js';
  </script>
</body>
</html>
