---
import '../styles/ui.css';
import '../styles/application.css';
import ThemeInit from '../components/ThemeInit.astro';
import { card, buttonPrimary } from '../lib/shadcn.js';
---
<!DOCTYPE html>
<html lang="es">
<head>
  <ThemeInit />
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&display=swap" />
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content="Tu servicio de internet está suspendido temporalmente." />
  <title>Servicio suspendido · NuweNet</title>
</head>
<body class="suspension-page flex min-h-dvh flex-col items-center justify-center p-6">
  <div class:list={[card, 'w-full max-w-[520px] overflow-hidden']}>
    <div class="border-b p-6">
      <div class="mb-5 text-destructive">
        <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7">
          <path d="M12 2a10 10 0 100 20 10 10 0 000-20z"/>
          <line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/>
        </svg>
      </div>
      <h1 class="mb-3 text-2xl font-semibold">Servicio Suspendido</h1>
      <p id="notice-message" class="text-sm text-muted-foreground">Tu conexión a internet ha sido suspendida temporalmente. Comunícate con la administración de tu edificio para regularizar tu situación.</p>
    </div>
    <div class="p-6">
      <div class="mb-5 flex items-start gap-3 text-sm">
        <svg class="shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>
        <p>El servicio se restablecerá automáticamente una vez que el administrador confirme tu pago o levante la restricción.</p>
      </div>
      <div class="mb-5 flex items-start gap-3 text-sm">
        <svg class="shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 10.81 19.79 19.79 0 01.01 2.18 2 2 0 012 0h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z"/></svg>
        <p>Contacta al administrador de tu edificio o accede a tu <strong>portal de autoservicio</strong> para consultar tus facturas y recibos.</p>
      </div>
      <p id="admin-contact"></p><p>Usa el enlace privado que te entregó la administración para abrir tu cuenta.</p>
      <a href="/portal" id="portal-link" class:list={[buttonPrimary, 'mt-6']}>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
        Ir a mi Portal de Autoservicio
      </a>
    </div>
  </div>
  <footer class="p-8 text-center text-xs text-muted-foreground">NuweNet · Sistema de Administración de Red</footer>
  <script>
    const params=new URLSearchParams(location.search),token=params.get('token');
    const link=document.querySelector<HTMLAnchorElement>('#portal-link');
    if(link){link.hidden=!token;if(token)link.href=`/portal?token=${encodeURIComponent(token)}`;}
    fetch('/api/portal/notice?building_id='+encodeURIComponent(params.get('building_id')||'')).then(r=>r.json()).then(data=>{
      const message=document.getElementById('notice-message'),contact=document.getElementById('admin-contact');
      if(message && data.message)message.textContent=data.message;if(contact)contact.textContent=data.contact||'';
    }).catch(()=>{});
  </script>
</body>
</html>
