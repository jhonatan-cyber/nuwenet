---
import DeferredPanels from '../components/DeferredPanels';
import DashboardLayout from '../layouts/DashboardLayout.astro';
import AccountMenu from '../components/AccountMenu.astro';
import AccountDialog from '../components/AccountDialog.astro';
import ThemeToggle from '../components/ThemeToggle';
---
<DashboardLayout>
  <main>
    <header class="floating-navbar flex items-center justify-between gap-4 px-5 max-[700px]:gap-2 max-[700px]:px-3">
      <div class="flex min-w-0 items-center gap-3">
        <button id="sidebar-toggle" class="hidden size-9 items-center justify-center rounded-md border bg-background hover:bg-muted max-[700px]:inline-flex" type="button" aria-label="Abrir navegación" aria-expanded="false" aria-controls="main-sidebar"><svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><path d="M4 6h16M4 12h16M4 18h16"/></svg></button>
        <span class="truncate text-sm"><span class="building-name text-muted-foreground">Mi edificio / </span><span id="breadcrumb">Resumen</span></span>
      </div>
      <div class="flex items-center gap-3 max-[700px]:gap-1.5">
        <select id="building-select" class="h-9 max-w-[180px] rounded-md border border-input bg-transparent px-3 text-sm shadow-xs max-[700px]:max-w-[120px]" aria-label="Edificio activo" hidden></select>
        <ThemeToggle client:load />
        <AccountMenu />
      </div>
    </header>
    <section class="content">
      <div id="view"></div>
      <DeferredPanels client:load />
    </section>
  </main>
  <AccountDialog />
  <div id="toast" role="status" aria-live="polite" style="display:none" class="fixed right-6 bottom-6 z-[100] max-w-[calc(100vw-48px)] rounded-lg border bg-card px-5 py-4 text-sm shadow-lg"></div>
</DashboardLayout>
<script>
  import '../scripts/dashboard';
</script>
