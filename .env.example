# PostgreSQL is required. Never place credentials in PUBLIC_* variables.
DB_DRIVER=postgres
PGHOST=127.0.0.1
PGPORT=5432
PGDATABASE=nuwenet
PGUSER=nuwenet
PGPASSWORD=replace_with_your_password
PGSSLMODE=disable
PORT=3000
HOST=127.0.0.1
# Required to store router credentials; keep this key across deployments.
# ROUTER_ENCRYPTION_KEY=your_32_byte_base64_key
# ROUTER_BROWSER_CHANNEL=chrome
# Sesión del panel. El primer usuario creado es el super-admin único y global
# (dueño del sistema, no pertenece a ningún edificio). Luego da de alta
# a los administradores y les asigna sus edificios.
# SESSION_TTL_HOURS=72
# Revisión automática de vencidos cada N minutos. 0 o ausente = solo manual.
# OVERDUE_CRON_MINUTES=0
# Símbolo de moneda mostrado en el panel (solo presentación).
# CURRENCY=Bs
# Canal de avisos a clientes. `log` guarda en base y consola; otros proveedores se implementan en notifier.service.ts.
# NOTIFY_CHANNEL=log
# El panel guarda reglas y automatizaciones en la base de datos.
# BACKUP_DIR=./backups
# COOKIE_SECURE=true
# ALLOWED_ORIGINS=https://panel.ejemplo.com
# TRUST_PROXY=loopback
# SETUP_TOKEN=choose_a_private_installation_code_for_remote_setup
